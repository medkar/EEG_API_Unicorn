+    srv._marqueurs = [(101.0, {"mode": "p300", "event": "flash", "target": 1}),
+                      (102.9, {"mode": "p300", "event": "flash", "target": 2}),
+                      (101.5, {"mode": "errp", "event": "feedback"})]
+    srv._marqueur_curseur = {}
